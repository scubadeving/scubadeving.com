---
interface Props {
  name: string;
  tagline: string;
  description: string;
  status: "in-development" | "coming-soon" | "available";
  platform?: string;
  href?: string;
}

const { name, tagline, description, status, platform, href } = Astro.props;

const statusLabel: Record<Props["status"], string> = {
  "in-development": "In development",
  "coming-soon": "Coming soon",
  available: "Available",
};

const statusColor: Record<Props["status"], string> = {
  "in-development": "text-amber-400 bg-amber-400/10 border-amber-400/20",
  "coming-soon": "text-ink-muted bg-surface-border/50 border-surface-border",
  available: "text-emerald-400 bg-emerald-400/10 border-emerald-400/20",
};
---

<div
  class="group relative flex flex-col gap-4 rounded-2xl border border-surface-border bg-surface-raised p-6 transition-colors hover:border-accent/30"
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="font-mono text-lg font-medium text-ink">{name}</h3>
      <p class="mt-0.5 text-sm text-ink-muted">{tagline}</p>
    </div>
    <span
      class={`shrink-0 rounded-full border px-2.5 py-0.5 text-xs font-medium ${statusColor[status]}`}
    >
      {statusLabel[status]}
    </span>
  </div>

  <p class="text-sm leading-relaxed text-ink-muted">{description}</p>

  <div class="mt-auto flex items-center justify-between">
    {platform && <span class="text-xs text-ink-muted/60">{platform}</span>}
    {
      href && (
        <a
          href={href}
          class="ml-auto text-xs font-medium text-accent hover:underline"
        >
          Learn more →
        </a>
      )
    }
  </div>
</div>

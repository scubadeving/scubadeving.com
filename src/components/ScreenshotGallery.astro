---
export interface Shot {
  src: string;
  alt: string;
  title: string;
  caption: string;
}

interface Props {
  shots: Shot[];
  label: string;
}

const { shots, label } = Astro.props;
---

<div
  role="region"
  aria-label={label}
  tabindex="0"
  class="-mx-6 overflow-x-auto px-6 pb-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
>
  <ul role="list" class="flex snap-x snap-mandatory gap-5">
    {shots.map((shot) => (
      <li class="w-[216px] shrink-0 snap-start">
        <figure>
          <img
            src={shot.src}
            alt={shot.alt}
            width="216"
            height="480"
            loading="lazy"
            decoding="async"
            class="rounded-2xl border border-surface-border"
          />
          <figcaption class="mt-3">
            <p class="text-sm font-medium text-ink">{shot.title}</p>
            <p class="mt-1 text-xs leading-relaxed text-ink-muted">{shot.caption}</p>
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>
</div>

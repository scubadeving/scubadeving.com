---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const entries = [
  {
    version: "0.2.0 — Alpha (in preparation)",
    label: "Current",
    items: [
      {
        type: "added",
        text: "An iOS version of LoopLogic is being prepared for a TestFlight alpha: checklists, cell calibration and analytics, scrubber tracking, gas math and gas mixing, settings and the safety notice. It is not open to testers yet.",
      },
      {
        type: "added",
        text: "Open source licenses screen listing every library the app is built with, with the full license text (Android and iOS).",
      },
      {
        type: "added",
        text: "iOS: an unfinished calibration can be resumed after the app is closed. Readings are kept for 30 minutes and are dropped if a cell was replaced.",
      },
      {
        type: "added",
        text: "iOS: Gas Math and Gas Mixing inputs are kept for 24 hours, shown with a note that they were restored and a Reset button. The current CNS value is never kept.",
      },
      {
        type: "added",
        text: "iOS: optional alerts for scrubber capacity and O₂ cell expiry, with a banner when notification permission is turned off. CNS exposure alerts are not on iOS yet.",
      },
      {
        type: "added",
        text: "iOS: vibration and sound feedback for checklist steps and timers, Gas Math, Gas Mixing and the scrubber, following the Settings switches.",
      },
      {
        type: "added",
        text: "Alerts on Android for scrubber capacity, O₂ cell expiry and CNS exposure — optional, generated on your device, no account required.",
      },
      {
        type: "added",
        text: "Home screen widget on Android — glanceable dive status and scrubber state.",
      },
      {
        type: "added",
        text: "Crash reporting via Firebase Crashlytics in Android and iOS release builds. No analytics, no advertising — crash data only, used to fix stability issues. Debug builds are unaffected.",
      },
      {
        type: "added",
        text: "Surface interval — see how long until your CNS % falls to a target.",
      },
      {
        type: "added",
        text: "Onboarding flow — guided first-launch setup covering unit preferences and CCR configuration, plus a one-time safety notice you must accept before using the app.",
      },
      {
        type: "added",
        text: "About & legal screen in-app — licenses, safety disclaimer, and version info accessible without leaving the app.",
      },
      {
        type: "added",
        text: "Multi-CCR support — manage several rebreather units in one app; cell, scrubber and maintenance records are kept per unit.",
      },
      {
        type: "added",
        text: "Gas math tools — CNS/OTU, best mix, gas density with helium fraction, setpoint optimizer, O₂ duration, SAC, bailout, rule of thirds, and an exposure log. Gas mixing tools — partial-pressure blends, top-up, fill capacity, temperature correction and equalization.",
      },
      {
        type: "added",
        text: "Dive status — an at-a-glance status from cell health, calibration, checklist and scrubber state, shown on the dashboard and the Android widget. A reminder, not a clearance.",
      },
      {
        type: "improved",
        text: "The setpoint optimizer now says plainly when no setpoint from 0.70 to 1.40 keeps CNS within your ceiling, instead of showing a recommendation that exceeds it.",
      },
      {
        type: "improved",
        text: "Gas Math rejects a negative depth instead of showing numbers for it, and the O₂ duration result says on screen that real use is higher than the estimate.",
      },
      {
        type: "improved",
        text: "Calculators were checked against published references and hand calculations, and give the same numbers in debug and release builds. A few reference checks are still open.",
      },
      {
        type: "improved",
        text: "Accessibility: labels, live regions for safety banners and the dive status badge, and contrast checks in every theme. A full screen-reader pass is still in progress.",
      },
      {
        type: "fixed",
        text: "Onboarding could finish even when saving your unit or preferences failed, leaving a unit with default settings and no error. It now stops and shows the error (Android and iOS).",
      },
      {
        type: "fixed",
        text: "iOS: a batch calibration step could be completed with a blank reading, and a cell with no oxygen reading could be recorded as a failed test. Every cell now needs a real reading.",
      },
      {
        type: "fixed",
        text: "iOS: Settings showed Import and Export rows that did nothing. They are hidden until backup is built.",
      },
      {
        type: "fixed",
        text: "The Vibration and Audio Alarms switches now apply in Gas Math, Gas Mixing and the Scrubber on Android.",
      },
      {
        type: "fixed",
        text: "A cell with no scrubber cycle after onboarding left the scrubber screen without data; the cycle is now created with the unit.",
      },
    ],
  },
];

const typeLabel: Record<string, string> = {
  added: "Added",
  improved: "Improved",
  fixed: "Fixed",
};

const typeColor: Record<string, string> = {
  added: "text-emerald-400 bg-emerald-400/10 border-emerald-400/20",
  improved: "text-accent bg-accent/10 border-accent/20",
  fixed: "text-amber-400 bg-amber-400/10 border-amber-400/20",
};
---

<Layout
  title="LoopLogic Changelog — scubadeving"
  description="Development changelog for LoopLogic. Follow what's being built and fixed before public release."
  ogImage="/og-looplogic.png"
>
  <div class="mx-auto max-w-4xl px-6 py-24">

    <Header showBack={true} />

    <main>
      <section class="mb-16">
        <h1 class="font-mono text-4xl font-medium tracking-tight text-ink sm:text-5xl">
          LoopLogic Changelog
        </h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-muted">
          User-facing changes as LoopLogic moves toward release. Technical infrastructure
          changes are omitted — this tracks what divers will actually see and use.
        </p>
      </section>

      <div class="space-y-12 mb-24">
        {entries.map((entry) => (
          <div>
            <div class="mb-6 flex items-center gap-3">
              <h2 class="font-mono text-lg font-medium text-ink">{entry.version}</h2>
              {entry.label && (
                <span class="rounded-full border border-accent/20 bg-accent/10 px-2.5 py-0.5 text-xs font-medium text-accent">
                  {entry.label}
                </span>
              )}
            </div>
            <div class="space-y-3">
              {entry.items.map((item) => (
                <div class="flex items-start gap-3">
                  <span class={`mt-0.5 shrink-0 rounded-full border px-2 py-0.5 text-[10px] font-medium ${typeColor[item.type]}`}>
                    {typeLabel[item.type]}
                  </span>
                  <p class="text-sm leading-relaxed text-ink-muted">{item.text}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

    </main>

    <Footer />

  </div>
</Layout>

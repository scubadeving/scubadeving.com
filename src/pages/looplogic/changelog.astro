---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const entries = [
  {
    version: "Unreleased — Alpha",
    label: "Current",
    items: [
      {
        type: "added",
        text: "Alpha release infrastructure — release signing, R8 shrinking, ProGuard rules, and a CI release workflow triggered on version tags.",
      },
      {
        type: "added",
        text: "Crash reporting via Firebase Crashlytics in release builds. No Analytics, no advertising — crash data only, used to fix stability issues. Debug builds are unaffected.",
      },
      {
        type: "added",
        text: "Structured logging via Timber — debug logs in development, crash-aware logging in release. All ad-hoc Log calls removed.",
      },
      {
        type: "added",
        text: "Home screen widget — glanceable dive authorization status and scrubber state directly from your Android home screen.",
      },
      {
        type: "added",
        text: "Push notifications — optional alerts for scrubber capacity, O₂ cell expiry and CNS exposure. Fully on-device, no account required.",
      },
      {
        type: "added",
        text: "Surface interval — see how long until your CNS % falls to a target.",
      },
      {
        type: "added",
        text: "Onboarding flow — guided first-launch setup covering unit preferences, CCR configuration, and a one-time safety notice you must accept before using the app.",
      },
      {
        type: "added",
        text: "About & legal screen in-app — licenses, safety disclaimer, and version info accessible without leaving the app.",
      },
      {
        type: "added",
        text: "Multi-CCR support — manage multiple rebreather units in a single profile; cell, scrubber and maintenance records are kept per unit.",
      },
      {
        type: "added",
        text: "Unit system — full metric and imperial support throughout the app, switchable at any time.",
      },
      {
        type: "added",
        text: "Gas math tools — CNS/OTU calculators, best mix, daily exposure tracking, and gas density safety check with helium fraction input.",
      },
      {
        type: "added",
        text: "Exposure log — save depth, time and setpoint with the CNS/OTU they add up to.",
      },
      {
        type: "added",
        text: "Dive authorization status — an at-a-glance status from cell health and checklist state, shown on the dashboard and home screen widget. A reminder, not a clearance.",
      },
      {
        type: "added",
        text: "KMP platform abstraction layer — file I/O seam so the codebase can be shared with iOS, which is in progress.",
      },
      {
        type: "improved",
        text: "Accessibility labels, nav-rail authorization badges and grouped semantics added across screens; a full screen-reader test pass is still in progress.",
      },
      {
        type: "improved",
        text: "Lifecycle-safe event handling across all feature screens, replacing bare LaunchedEffect collectors.",
      },
      {
        type: "improved",
        text: "Cell manufacturer display names are locale-stable. Checklist category parsing handles Turkish-I and similar locale edge cases.",
      },
      {
        type: "fixed",
        text: "Dashboard checklist card required a double-tap to navigate. Root cause: unconditional pager scroll animation on first composition.",
      },
      {
        type: "fixed",
        text: "Auth navigation routing restored after regression introduced by use-case wiring changes.",
      },
      {
        type: "fixed",
        text: "Scrubber UI state made snapshot-stable. Accessibility labels and localisation gaps resolved.",
      },
    ],
  },
];

const typeLabel: Record<string, string> = {
  added: "Added",
  improved: "Improved",
  fixed: "Fixed",
};

const typeColor: Record<string, string> = {
  added: "text-emerald-400 bg-emerald-400/10 border-emerald-400/20",
  improved: "text-accent bg-accent/10 border-accent/20",
  fixed: "text-amber-400 bg-amber-400/10 border-amber-400/20",
};
---

<Layout
  title="LoopLogic Changelog — scubadeving"
  description="Development changelog for LoopLogic. Follow what's being built and fixed before public release."
  ogImage="/og-looplogic.png"
>
  <div class="mx-auto max-w-4xl px-6 py-24">

    <Header showBack={true} />

    <main>
      <section class="mb-16">
        <h1 class="font-mono text-4xl font-medium tracking-tight text-ink sm:text-5xl">
          LoopLogic Changelog
        </h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-muted">
          User-facing changes as LoopLogic moves toward release. Technical infrastructure
          changes are omitted — this tracks what divers will actually see and use.
        </p>
      </section>

      <div class="space-y-12 mb-24">
        {entries.map((entry) => (
          <div>
            <div class="mb-6 flex items-center gap-3">
              <h2 class="font-mono text-lg font-medium text-ink">{entry.version}</h2>
              {entry.label && (
                <span class="rounded-full border border-accent/20 bg-accent/10 px-2.5 py-0.5 text-xs font-medium text-accent">
                  {entry.label}
                </span>
              )}
            </div>
            <div class="space-y-3">
              {entry.items.map((item) => (
                <div class="flex items-start gap-3">
                  <span class={`mt-0.5 shrink-0 rounded-full border px-2 py-0.5 text-[10px] font-medium ${typeColor[item.type]}`}>
                    {typeLabel[item.type]}
                  </span>
                  <p class="text-sm leading-relaxed text-ink-muted">{item.text}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

    </main>

    <Footer />

  </div>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { pressEmail } from "../data/site";
import { products } from "../data/products";
---

<Layout
  title="Press — scubadeving"
  description="Press resources for scubadeving and its apps LoopLogic and HydroVault. Fact sheets, media assets, and press contact."
  ogImage="/og-default.png"
>
  <div class="mx-auto max-w-4xl px-6 py-24">

    <Header showBack={true} />

    <main>
      <section class="mb-16">
        <h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
          Press
        </h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-muted">
          Resources for journalists, content creators, and community members covering
          scubadeving or its apps. For press inquiries, email{" "}
          <a
            href={`mailto:${pressEmail}`}
            class="rounded text-accent underline transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {pressEmail}
          </a>.
        </p>
      </section>

      <!-- Studio -->
      <section class="mb-16">
        <h2 class="mb-4 text-xs font-medium uppercase tracking-widest text-ink-muted">
          About scubadeving
        </h2>
        <div class="rounded-2xl border border-surface-border bg-surface-raised p-6">
          <p class="text-sm leading-relaxed text-ink-muted">
            scubadeving is an independent software studio building tools for the dive
            community. Every product is made by divers, for divers — focused on the
            technical and professional end of the sport where accurate record-keeping
            and equipment management actually matter.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">
            The studio's first two apps, LoopLogic and HydroVault, are both Android-first
            and built on Kotlin Multiplatform for future iOS and web reach.
          </p>
          <dl class="mt-6 grid gap-3 sm:grid-cols-2">
            {[
              { term: "Founded", detail: "2022" },
              { term: "Location", detail: "United States" },
              { term: "Platform", detail: "Android (iOS & more planned)" },
              { term: "Contact", detail: pressEmail },
            ].map((item) => (
              <div>
                <dt class="text-xs font-medium text-ink-muted">{item.term}</dt>
                <dd class="mt-0.5 text-sm text-ink">{item.detail}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <!-- App fact sheets -->
      <section class="mb-16">
        <h2 class="mb-4 text-xs font-medium uppercase tracking-widest text-ink-muted">
          Apps
        </h2>
        <div class="space-y-4">
          {products.map((product) => (
            <div class="rounded-2xl border border-surface-border bg-surface-raised p-6">
              <div class="flex items-start gap-4">
                {product.appIcon && (
                  <img
                    src={product.appIcon}
                    alt={`${product.name} app icon`}
                    width="56"
                    height="56"
                    class="shrink-0 rounded-[14px]"
                  />
                )}
                <div class="min-w-0 flex-1">
                  <h3 class="font-mono text-base font-medium text-ink">{product.name}</h3>
                  <p class="mt-0.5 text-sm text-ink-muted">{product.tagline}</p>
                </div>
              </div>
              <p class="mt-4 text-sm leading-relaxed text-ink-muted">{product.heroDescription}</p>
              <dl class="mt-5 grid gap-3 sm:grid-cols-3">
                {[
                  { term: "Status", detail: product.status === "in-development" ? "In development" : product.status === "available" ? "Available" : "Coming soon" },
                  { term: "Platform", detail: product.platform },
                  { term: "Price", detail: "TBD" },
                ].map((item) => (
                  <div>
                    <dt class="text-xs font-medium text-ink-muted">{item.term}</dt>
                    <dd class="mt-0.5 text-sm text-ink">{item.detail}</dd>
                  </div>
                ))}
              </dl>
              <div class="mt-5 flex flex-wrap gap-3">
                <a
                  href={`/${product.id}`}
                  class="text-xs font-medium text-accent hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                >
                  Product page →
                </a>
                <a
                  href={product.appIcon}
                  download
                  class="text-xs font-medium text-ink-muted hover:text-ink hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                >
                  Download icon →
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Media assets -->
      <section class="mb-16">
        <h2 class="mb-4 text-xs font-medium uppercase tracking-widest text-ink-muted">
          Media assets
        </h2>
        <div class="rounded-2xl border border-surface-border bg-surface-raised p-6 space-y-4">
          <div>
            <p class="text-sm font-medium text-ink">App icons</p>
            <p class="mt-1 text-xs leading-relaxed text-ink-muted">
              512×512 PNG. Available via the download links in each app fact sheet above.
              Use on a dark background for best results.
            </p>
          </div>
          <div>
            <p class="text-sm font-medium text-ink">Screenshots</p>
            <p class="mt-1 text-xs leading-relaxed text-ink-muted">
              App screenshots are not yet available — both apps are pre-release.
              Email {" "}
              <a
                href={`mailto:${pressEmail}`}
                class="text-accent underline hover:no-underline"
              >{pressEmail}</a>
              {" "} and we'll send what we have.
            </p>
          </div>
          <div>
            <p class="text-sm font-medium text-ink">Studio wordmark</p>
            <p class="mt-1 text-xs leading-relaxed text-ink-muted">
              Available on request. Email {" "}
              <a
                href={`mailto:${pressEmail}`}
                class="text-accent underline hover:no-underline"
              >{pressEmail}</a>.
            </p>
          </div>
        </div>
      </section>

      <!-- Usage guidelines -->
      <section class="mb-16">
        <h2 class="mb-4 text-xs font-medium uppercase tracking-widest text-ink-muted">
          Usage guidelines
        </h2>
        <div class="rounded-2xl border border-surface-border bg-surface-raised p-6">
          <p class="text-sm leading-relaxed text-ink-muted">
            You may use scubadeving's name, app names, and provided media assets in editorial
            coverage of the studio or its apps. Do not alter app icons, imply endorsement,
            or use assets in a misleading context. For anything outside standard editorial
            use, email {" "}
            <a
              href={`mailto:${pressEmail}`}
              class="text-accent underline hover:no-underline"
            >{pressEmail}</a>.
          </p>
        </div>
      </section>

    </main>

    <Footer />

  </div>
</Layout>

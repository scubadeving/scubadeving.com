---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { products } from "../data/products";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "scubadeving",
  url: "https://scubadeving.com",
  sameAs: [
    "https://github.com/scubadeving",
    "https://x.com/scubadeving",
    "https://instagram.com/scubadeving",
    "https://youtube.com/@scubadeving",
    "https://bsky.app/profile/scubadeving.com",
  ],
};
---

<Layout
  title="scubadeving — dive software that doesn't suck"
  description="Independent studio building software for the dive community. LoopLogic and HydroVault — tools made by people who actually dive."
  ogImage="/og-default.png"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-4xl px-6 py-24">

    <Header />

    <main>
      <section class="mb-24">
        <h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
          Dive software that doesn't suck.
        </h1>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-ink-muted">
          Independent studio building software for the dive community. Tools made by people who actually dive.
        </p>
      </section>

      <section class="mb-24">
        <h2 class="mb-6 text-xs font-medium uppercase tracking-widest text-ink-muted">
          Products
        </h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            products.map((product) => (
              <ProductCard
                name={product.name}
                tagline={product.tagline}
                description={product.cardDescription}
                status={product.status}
                platform={product.platform}
                href={`/${product.id}`}
                appIcon={product.appIcon}
              />
            ))
          }
        </div>
      </section>
    </main>

    <Footer />

  </div>
</Layout>
